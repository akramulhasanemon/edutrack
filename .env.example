# ==============================================================================
# EduTrack - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in the values below as needed:
# cp .env.example .env

# [Optional] Google Gemini API Key
# If provided, enables AI Academic Advisor via Gemini 2.5 Flash.
# If omitted or empty, EduTrack automatically uses its rule-based local coaching fallback.
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=

# [Optional] Custom Database Location
# By default, EduTrack uses 'edutrack.db' located at the project root.
# Uncomment and customize only if you want to store the database elsewhere:
# EDUTRACK_DB_PATH=./edutrack.db
